# Agent provider. Any OpenAI-compatible endpoint works.
GROQ_API_KEY=
AGENT_BASE_URL=https://api.groq.com/openai/v1
AGENT_MODEL=openai/gpt-oss-120b

# Pays for devnet memo transactions. Accepts a base58 64-byte secret,
# a JSON byte array, or a 32-byte hex seed.
MARQUE_RELAYER_SECRET=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
